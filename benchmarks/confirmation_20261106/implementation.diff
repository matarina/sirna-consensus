+[build-system]
+requires = ["hatchling"]
+build-backend = "hatchling.build"
+
+[project]
+name = "sirna-consensus"
+version = "1.1.0"
+description = "Consensus de novo siRNA design: wrap several open-source design tools, normalise their output onto one coordinate axis, vote, filter and rank."
+readme = "README.md"
+requires-python = ">=3.9"
+license = { text = "MIT" }
+authors = [{ name = "sirna-consensus contributors" }]
+keywords = ["siRNA", "RNAi", "de novo design", "consensus", "bioinformatics"]
+classifiers = [
+  "Development Status :: 4 - Beta",
+  "Intended Audience :: Science/Research",
+  "License :: OSI Approved :: MIT License",
+  "Programming Language :: Python :: 3",
+  "Topic :: Scientific/Engineering :: Bio-Informatics",
+]
+dependencies = []
+
+[project.optional-dependencies]
+dev = ["pytest>=7", "pytest-cov"]
+
+[project.scripts]
+sirna-consensus = "sirna_consensus.cli:main"
+
+[project.urls]
+Homepage = "https://github.com/matarina/sirna-consensus"
+
+[tool.hatch.build.targets.wheel]
+packages = ["src/sirna_consensus"]
+
+[tool.ruff]
+target-version = "py39"
+line-length = 100
+extend-exclude = ["vendor"]
+
+[tool.ruff.lint]
+select = ["E4", "E7", "E9", "F", "W", "I", "UP", "B", "SIM", "RUF", "FA"]
+ignore = [
+  "UP037",   # quoted annotations are deliberate for py3.9 runtime safety
+  "RUF100",  # keep explicit noqa markers even when the code is not enabled
+  "ISC004",  # implicit string concatenation inside a list reads fine here
+  "ISC004",
+  "RUF001",  # the prime in 5'→3' is intentional typography
+]
+
+[tool.pytest.ini_options]
+testpaths = ["tests"]
+addopts = "-q"
+markers = ["external: requires an installed external design tool"]
