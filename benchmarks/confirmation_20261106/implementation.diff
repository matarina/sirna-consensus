+    monkeypatch.setenv("SIREN_THREADS", "nonsense")
+    assert ToolEnv().siren_threads > 0          # falls back, never raises
+
+    monkeypatch.setenv("SIREN_THREADS", "0")
+    assert ToolEnv().siren_threads > 0
